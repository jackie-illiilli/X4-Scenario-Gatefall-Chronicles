<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s05_phase2_president_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_president" />
    <object_group name="targets">
      <reference object="target_president" />
    </object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <!-- Close presidential review: keep the camera on the Cerberus rather than the escort screen. -->
        <shot name="PresidentReviewCloseOrbit" environment="scenezone" duration="45000">
          <camera_orbit reference="target_president" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="1500" angle="-42" elevation="10" />
            <end distance="900" angle="32" elevation="6" time="44000" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
