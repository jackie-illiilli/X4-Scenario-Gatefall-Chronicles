<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s07_station_memory_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_station" />
    <object_group name="targets"><reference object="target_station" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="SlowStationOrbit" environment="scenezone" duration="120000">
          <camera_orbit reference="target_station" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="9000" angle="-32" elevation="11" />
            <end distance="6500" angle="58" elevation="7" time="119500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
