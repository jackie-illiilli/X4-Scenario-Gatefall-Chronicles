<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s07_phase4_player_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_player_ship" />
    <object_group name="targets"><reference object="target_player_ship" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="ParadigmArrival" environment="scenezone" duration="20000">
          <camera_orbit reference="target_player_ship" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="9000" angle="-30" elevation="11" />
            <end distance="6200" angle="34" elevation="6" time="19500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
