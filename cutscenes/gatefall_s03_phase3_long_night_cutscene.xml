<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s03_phase3_long_night_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_long_night" />
    <object_group name="targets">
      <reference object="target_long_night" />
    </object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="LongNightReveal" environment="scenezone" duration="30000">
          <camera_orbit reference="target_long_night" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="19000" angle="-18" elevation="10" />
            <end distance="12500" angle="12" elevation="7" time="29500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
