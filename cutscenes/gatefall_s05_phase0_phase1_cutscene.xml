<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s05_phase0_phase1_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_player" />
    <object_group name="targets">
      <reference object="target_player" />
      <reference object="target_destroyer_first" />
      <reference object="target_destroyer_last" />
    </object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <!-- Phase 0: consciousness settles into the Xenon F beside the Morning Star gate. -->
        <shot name="SupervisorOnline" environment="scenezone" duration="19000">
          <camera_orbit reference="target_player" orient_to="object" cycle="none" interpolation="smooth">
            <begin distance="260" angle="-30" elevation="12" />
            <end distance="180" angle="28" elevation="8" time="18500" />
          </camera_orbit>
        </shot>
        <!-- Phase 1: travel from the first Behemoth to the final Behemoth. -->
        <shot name="DestroyerColumns" environment="scenezone" duration="13000">
          <camera_flyfromto reference="target_destroyer_first" distance="1400" flyto_reference="target_destroyer_last" flyto_distance="1600" interpolation="smooth" time_firstobject="1500" time_fly="10000" cycle="none" orient_to="object" orbit1_yaw_start="-24" orbit1_yaw_end="-24" orbit1_elevation="12" orbit2_yaw_start="-24" orbit2_yaw_end="-24" orbit2_pitch="12" />
        </shot>
        <!-- Hold on the last Behemoth while the expedition commander finishes the broadcast. -->
        <shot name="FinalDestroyerOrbit" environment="scenezone" duration="40000">
          <camera_orbit reference="target_destroyer_last" orient_to="object" cycle="none" interpolation="smooth">
            <begin distance="1600" angle="-24" elevation="12" />
            <end distance="1450" angle="38" elevation="9" time="39500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
