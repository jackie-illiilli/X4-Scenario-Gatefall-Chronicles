<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s05_phase3_builder_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_builder" />
    <object_group name="targets"><reference object="target_builder" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="BuilderMediumWide" environment="scenezone" duration="22000">
          <camera_orbit reference="target_builder" orient_to="object" interpolation="linear" cycle="none">
            <begin distance="5200" angle="-25" elevation="12" />
            <end distance="5200" angle="-25" elevation="12" time="21000" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
