  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_player_ship" />
    <object_group name="targets"><reference object="target_player_ship" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="SurvivorFleetOrbit" environment="scenezone" duration="28000">
          <camera_orbit reference="target_player_ship" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="10000" angle="-35" elevation="16" />
            <end distance="7000" angle="24" elevation="9" time="27500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
