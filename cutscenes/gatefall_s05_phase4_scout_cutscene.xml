<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s05_phase4_scout_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_scout" />
    <object_group name="targets"><reference object="target_scout" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="HATScoutCloseStatic" environment="scenezone" duration="18000">
          <camera_orbit reference="target_scout" orient_to="object" interpolation="linear" cycle="none">
            <begin distance="180" angle="-28" elevation="8" />
            <end distance="180" angle="-28" elevation="8" time="17000" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
