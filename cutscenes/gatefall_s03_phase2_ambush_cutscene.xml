<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s03_phase2_ambush_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_xenon_k" />
    <object_group name="targets">
      <reference object="target_xenon_k" />
    </object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="AmbushKClose" environment="scenezone" duration="12000">
          <camera_orbit reference="target_xenon_k" orient_to="object" cycle="none" interpolation="smooth">
            <begin distance="3300" angle="-20" elevation="6" />
            <end distance="2600" angle="20" elevation="11" time="11500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
