<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s06_phase5_beacon_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_beacon" />
    <object_group name="targets"><reference object="target_beacon" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="XenonJumpBeaconClose" environment="scenezone" duration="14000">
          <camera_orbit reference="target_beacon" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="75" angle="-32" elevation="10" />
            <end distance="48" angle="24" elevation="6" time="13500" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
