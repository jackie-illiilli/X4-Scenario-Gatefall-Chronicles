<?xml version="1.0" encoding="utf-8"?>
<cutscene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="cutscenes.xsd">
  <director key="gatefall_s05_phase3_annihilator_cutscene" />
  <environments>
    <environment_implicit name="scenezone" zone="@auto:target_annihilator" />
    <object_group name="targets"><reference object="target_annihilator" /></object_group>
  </environments>
  <presentation>
    <actions>
      <sequence name="Main" start="0">
        <shot name="AnnihilatorCloseOrbit" environment="scenezone" duration="18000">
          <camera_orbit reference="target_annihilator" orient_to="object" interpolation="smooth" cycle="none">
            <begin distance="6500" angle="-32" elevation="12" />
            <end distance="6500" angle="18" elevation="10" time="17000" />
          </camera_orbit>
        </shot>
      </sequence>
    </actions>
  </presentation>
</cutscene>
